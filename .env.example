# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

PROVISIONING_SECRET=
PROVISIONING_SECRET_REQUIRED=true
TWENTY_ADMIN_EMAIL=
TWENTY_ADMIN_PASSWORD=
MATTERMOST_ADMIN_EMAIL=
MATTERMOST_ADMIN_PASSWORD=
NEXT_ERP_TOKEN=
