SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@local.com
SUPERSET_SECRET_KEY=

OUTLINE_SECRET_KEY=openssl rand -hex 32
OUTLINE_UTILS_SECRET=openssl rand -hex 32
