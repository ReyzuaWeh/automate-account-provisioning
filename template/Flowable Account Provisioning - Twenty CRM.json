      ],
      "id": "4a9a3e6e-6f8e-4ed7-9a9c-b0075066f8e0",
      "name": "If"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://server:3000/metadata",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"mutation getLoginTokenFromCredentials($email: String!, $password: String!, $origin: String!) {\\n  getLoginTokenFromCredentials(email: $email, password: $password, origin: $origin) {\\n    loginToken {\\n      token\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"email\": \"{{ $env.TWENTY_ADMIN_EMAIL }}\",\n    \"password\": \"{{ $env.TWENTY_ADMIN_PASSWORD }}\",\n    \"origin\": \"{{ $env.SERVER_URL || 'http://localhost:3000' }}\"\n  },\n  \"operationName\": \"getLoginTokenFromCredentials\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -480,
        176
      ],
      "id": "f305ecf2-0a2f-4fde-aac6-7c791c2b7e0d",
      "name": "Login to Admin"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://server:3000/metadata",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"mutation getAuthTokensFromLoginToken($loginToken: String!, $origin: String!) {\\n  getAuthTokensFromLoginToken(loginToken: $loginToken, origin: $origin) {\\n    tokens {\\n      accessOrWorkspaceAgnosticToken {\\n        token\\n      }\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"loginToken\": \"{{ $json.data.getLoginTokenFromCredentials.loginToken.token }}\",\n    \"origin\": \"{{ $env.SERVER_URL || 'http://localhost:3000' }}\"\n  },\n  \"operationName\": \"getAuthTokensFromLoginToken\"\n}",
        "options": {}
      },
