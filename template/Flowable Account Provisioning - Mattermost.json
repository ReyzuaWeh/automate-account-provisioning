        "method": "POST",
        "url": "http://mattermost:8065/api/v4/users",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.headers.token }}"
